bin/
# Scoped, not a blanket "dist/" — that matched internal/webui/dist/ too
# (gitignore patterns without a leading slash match at any depth) and
# silently blocked the tracked placeholder there despite the negation
# further down, since git can't re-include a file whose parent directory
# is already excluded. Broke `go build` on every fresh clone/CI run.
/dist/
packaging/iso/dist/
*.log

# Go
/vendor/

# Node / SvelteKit
web/node_modules/
web/.svelte-kit/
web/build/

# Real frontend builds land in internal/webui/dist/ (go:embed'd into
# cmd/server) — ignore everything a real build generates there except the
# tracked placeholder index.html that keeps `go build` working before the
# frontend has ever been built.
internal/webui/dist/*
!internal/webui/dist/index.html

# Tauri / Rust
desktop/src-tauri/target/
desktop/node_modules/

# Local data
*.db
*.sqlite
data/
.env
