[Unit]
Description=Update FaroOS central panel safely
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/faroos/update.env
EnvironmentFile=-/etc/faroos/server-update.env
ExecStart=/usr/local/libexec/faroos-server-update --component server
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /usr/local/libexec /var/lib/faroos
NoNewPrivileges=true
