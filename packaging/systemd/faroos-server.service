[Unit]
Description=FaroOS central panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=faroos
Group=faroos
WorkingDirectory=/var/lib/faroos/server
EnvironmentFile=-/etc/faroos/server.env
ExecStart=/usr/local/bin/faroos-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
